# Arkiv Network Configuration
# Copy this file to .env and fill in your values

# Space ID for data isolation
# Use 'ns' for the workshop (shared space where all participants can see each other's data)
# For production, use your own unique space ID
SPACE_ID=ns

# Alternative space ID (optional)
# Used as fallback if SPACE_ID is not set
# BETA_SPACE_ID=ns

# Private key for signing transactions (REQUIRED for write operations)
# Must start with 0x
# Generate a testnet wallet private key for the workshop
# Example: ARKIV_PRIVATE_KEY=0x1234567890abcdef1234567890abcdef1234567890abcdef1234567890abcdef
ARKIV_PRIVATE_KEY=0x

# Note: The app is configured to use Mendoza testnet by default
# No additional network configuration needed
