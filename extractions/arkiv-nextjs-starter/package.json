{
  "name": "arkiv-nextjs-starter",
  "version": "0.1.0",
  "description": "Next.js starter template for Arkiv applications",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "seed": "tsx scripts/seed.ts",
    "test:smoke": "tsx scripts/smoke-test.ts",
    "test:conformance": "tsx scripts/smoke-test.ts"
  },
  "dependencies": {
    "@arkiv-network/sdk": "^0.1.0",
    "next": "^15.5.28",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@types/node": "^20.19.43",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.6.1",
    "postcss": "^8.5.31",
    "tailwindcss": "^3.4.19",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3"
  },
  "overrides": {
    "next": {
      "postcss": "$postcss"
    },
    "postcss-selector-parser": "^7.1.7"
  }
}
